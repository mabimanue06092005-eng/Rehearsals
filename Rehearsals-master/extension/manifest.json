{
  "manifest_version": 3,
  "name": "Rehearsals — Live Call Coach",
  "version": "0.1.0",
  "description": "Live pacing, filler-word, and coaching cues while you're on an actual call — using your microphone only, never the other person's audio.",
  "key": "",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://rehearsals.pages.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Rehearsals live coach"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
